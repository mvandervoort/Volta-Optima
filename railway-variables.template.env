# Railway omgevingsvariabelen template
# Gebruik dit bestand als referentie voor het configureren van variabelen in Railway
# KOPIEER DIT NAAR railway-variables.env VÓÓRdat je echte waarden invult
# VOEG GEEN GEVOELIGE WAARDEN TOE AAN GIT!

# App limieten
ADVICE_LIMIT_LOGGED_IN_MULTIPLIER=3
ADVICE_LIMIT_PER_DAY=3
ADVICE_LIMIT_TOTAL=7

# CMS integratie
DIRECTUS_API_KEY=your-directus-api-key
DIRECTUS_URL=https://cms.example.com

# GitHub
GITHUB_TOKEN=your-github-token

# Analytics
GOOGLE_ANALYTICS_ID=your-ga-id
GOOGLE_API_KEY=your-google-api-key

# Database
QUESTDB_PASSWORD=your-questdb-password
QUESTDB_URL=https://questdb.example.com
QUESTDB_USERNAME=your-questdb-username

# Email
RESEND_API_KEY=your-resend-api-key

# Auth
SUPABASE_KEY=your-supabase-key
SUPABASE_URL=https://your-project.supabase.co

# Railway-specifieke variabelen (hoeven niet te worden ingesteld, worden automatisch toegevoegd)
# PORT - wordt automatisch ingesteld door Railway

# Applicatie configuratie
# REFLEX_ENV=prod - wordt automatisch ingesteld in Dockerfile.railway

# Server-Side Rendering configuratie
# Deze variabele helpt bij het oplossen van "document is not defined" errors
REFLEX_DISABLE_SSR=1